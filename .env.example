# ---- Rental management backend (/admin) ----
# Supabase project for the reservation pipeline. When unset, the admin backend
# runs in DEMO mode (sample data, no persistence) so it's fully viewable.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (shared password gate). Change this for production.
ADMIN_PASSWORD=
# Signs the session cookie, which now carries the role.
#
# MANDATORY, and must differ from ADMIN_PASSWORD, once VIEWER_PASSWORD is set:
# a read-only user's browser holds that signature in the clear, so keying it
# with the admin password would hand them an offline cracking oracle for it.
# No session of either role can be issued in that configuration, and the login
# page says what to fix.
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Read-only account. Signs in with the account name AND this password, and can
# view every admin page but cannot change anything or send mail. Leave
# VIEWER_PASSWORD unset to disable the read-only login entirely.
VIEWER_EMAIL=            # defaults to inquiry@mototoursjapan.com
VIEWER_PASSWORD=

# ---- Gmail API (optional) ----
# Lets the admin SEND the JP reservation / customer confirmation email straight
# from the company mailbox. One-time setup:
#   1. Google Cloud console → enable Gmail API on a project.
#   2. Create an OAuth client (type: Web/Desktop). Note client id + secret.
#   3. Authorize once with scope https://www.googleapis.com/auth/gmail.compose
#      (which also grants send) and obtain a refresh token — e.g. via the OAuth
#      Playground, signed in as info@helmetking.com.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The From: header. Gmail only honours it when the authorised account owns that
# address or has it as a verified "send mail as" alias; otherwise Gmail rewrites
# it to the account's own address. Visit /api/admin/gmail-status (logged into
# the admin) to see which mailbox the token belongs to and whether this address
# is usable.
GMAIL_SENDER=            # e.g. "Helmet King <info@helmetking.com>"

# Reservation email recipients. Both have live defaults in
# lib/reservations/recipients.ts — set these only to override.
RENTAL819_JP_EMAIL=      # JP partner; overrides the default inquiry@mototoursjapan.com
RESERVATION_COPY_EMAILS= # comma-separated HK copies: Cc on the JP mail, Bcc on the customer mail

# ---- Public booking form ----
# Optional: forward booking-form submissions to email/Slack/CRM in addition to
# creating a reservation record.
BOOKING_WEBHOOK_URL=

# New-booking Slack alert: emailed to the channel's "email to channel" address.
# Requires the Gmail API above to be configured (the gmail.compose scope sends).
# Defaults in code to the 電單車旅行 channel address; override here to change it.
SLACK_BOOKING_EMAIL=
