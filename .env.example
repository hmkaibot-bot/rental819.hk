# ---- Rental management backend (/admin) ----
# Supabase project for the reservation pipeline. When unset, the admin backend
# runs in DEMO mode (sample data, no persistence) so it's fully viewable.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (shared password gate). Change this for production.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Public booking form ----
# Optional: forward booking-form submissions to email/Slack/CRM in addition to
# creating a reservation record.
BOOKING_WEBHOOK_URL=
